-static uint64_t bounded_offset(
-    mpfr_prec_t precision, uint64_t raw_offset) {
-  if (precision <= 3) {
-    return 0;
-  }
-  unsigned offset_bits = (unsigned)(precision - 3);
-  if (offset_bits >= 64) {
-    return raw_offset;
-  }
-  return raw_offset & ((UINT64_C(1) << offset_bits) - 1);
-}
