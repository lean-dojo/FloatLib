-/*
- * MPFR stores a normalized significand left-aligned in little-endian GMP
- * limbs. Removing the unused low padding yields the same low 64 fraction bits
- * that ExecFloat contributes to its benchmark sink.
- */
-static uint64_t mpfr_low_significand_bits(mpfr_srcptr value) {
-  if (mpfr_zero_p(value)) {
-    return 0;
-  }
-  mpfr_prec_t precision = mpfr_get_prec(value);
-  size_t limb_count =
-      ((size_t)precision + GMP_NUMB_BITS - 1) / GMP_NUMB_BITS;
-  unsigned padding =
-      (unsigned)(limb_count * GMP_NUMB_BITS - (size_t)precision);
-  const mp_limb_t *limbs =
-      (const mp_limb_t *)mpfr_custom_get_significand(value);
-
-#if GMP_NUMB_BITS == 64
-  __uint128_t window = (__uint128_t)limbs[0];
-  if (limb_count > 1) {
-    window |= (__uint128_t)limbs[1] << 64;
-  }
-  return (uint64_t)(window >> padding);
-#elif GMP_NUMB_BITS == 32
-  __uint128_t window = (__uint128_t)limbs[0];
-  if (limb_count > 1) {
-    window |= (__uint128_t)limbs[1] << 32;
-  }
-  if (limb_count > 2) {
-    window |= (__uint128_t)limbs[2] << 64;
-  }
-  return (uint64_t)(window >> padding);
-#else
-#error "The benchmark supports GMP limbs of 32 or 64 bits."
-#endif
-}
