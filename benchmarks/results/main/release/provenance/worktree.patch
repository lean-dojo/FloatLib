-      FUNCTION(result, xs[i], ys[i], MPFR_RNDN);                             \
-      sink = mix64(sink, mpfr_low_significand_bits(result));                 \
-    }                                                                        \
-    mpfr_clear(result);                                                      \
-    return sink;                                                             \
-  }
