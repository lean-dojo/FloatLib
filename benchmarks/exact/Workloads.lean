/-!
# Kernel checks of other projects, as they write them and on FloatLib's kernel functions

Each section copies the kernel-evaluated definition of a public project (named with its source
file) and times it against the same check written with `FloatLib.Numerics.Kernel`. Nothing of the
projects is built: only the definitions that Lean's kernel evaluates are reproduced here.

* PrimeCert (`b-mehta/PrimeCert`, `PrimeCert/PowMod.lean`): `powModK`, the modular power of its
  Pocklington certificates.
* EllipticCurveRank (`b-mehta/EllipticCurveRank`, `ECCompute/Kernel.lean`): `checkPoint`, the
  quadratic-residue mask `qrMask`, and the `𝔽₂` matrix-inverse check `F2Invert.checkInv`.
* HighlyAbundant (`b-mehta/HighlyAbundant`, `HighlyAbundant/IsHA/SageKernel.lean`): the divisor
  sum of a prime power and the comparison `goal ≤ σ(p ^ k)` of `expChildrenK`.

The last two sections copy nothing. They time FloatLib's `Packed` rows on their own: a product of
two rows with its range checks and `ℓ¹` norm against the same norm computed entry by entry, and
the guard and `ℓ¹` norm of one row.

The bound of a logarithm and of an exponential on the binary grid uses only definitions outside
`FloatLib.Numerics.Kernel`, so it is in `Baseline.lean`.
-/

open FloatLibBenchmarks.Exact
open FloatLib.Numerics FloatLib.Numerics.Interval FloatLib.Numerics.Kernel

/-! ## PrimeCert: `3 ^ (N - 1) % N = 1` for primes `N` -/

/-- `powModK` of PrimeCert, `PrimeCert/PowMod.lean`. -/
noncomputable def powModK (a b n : Nat) : Nat :=
  aux b.succ (a.mod n) b 1
where
  aux : Nat → ((a b c : Nat) → Nat) :=
    Nat.rec (fun _ _ _ => 0)
      (fun _ r a b c =>
        (b.beq 0).rec
          (((b.mod 2).beq 0).rec
            (r ((a.mul a).mod n) (b.div 2) ((a.mul c).mod n))
            (r ((a.mul a).mod n) (b.div 2) c))
          (c.mod n))

def p61 : Nat := 2 ^ 61 - 1
def p127 : Nat := 2 ^ 127 - 1
def p255 : Nat := 2 ^ 255 - 19
def p256 : Nat := 2 ^ 256 - 2 ^ 224 + 2 ^ 192 + 2 ^ 96 - 1
def p384 : Nat := 2 ^ 384 - 2 ^ 128 - 2 ^ 96 + 2 ^ 32 - 1
def p521 : Nat := 2 ^ 521 - 1
def p1279 : Nat := 2 ^ 1279 - 1
def p2203 : Nat := 2 ^ 2203 - 1
def p4423 : Nat := 2 ^ 4423 - 1

#kernel_term "primecert/61/powModK" Nat.beq (powModK 3 (p61 - 1) p61) 1
#kernel_term "primecert/61/powMod" Nat.beq (powMod 3 (p61 - 1) p61) 1
