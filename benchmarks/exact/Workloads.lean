/-! ## EllipticCurveRank -/

/-- `checkPoint` of EllipticCurveRank, `ECCompute/Kernel.lean`: core's `Int.mul` and `Int.add`. -/
noncomputable def checkPoint (a₂ a₄ a₆ : Int) (x y : Rat) : Bool :=
  let xn := x.num; let xd := x.den
  let yn := y.num; let yd := y.den
  let xd2 := xd.mul xd; let xd3 := xd2.mul xd
  let yd2 := yd.mul yd
  let xn2 := xn.mul xn; let xn3 := xn2.mul xn
  let yn2 := yn.mul yn
  (yn2.mul xd3).beq'
    ((((xn3.mul yd2).add (((a₂.mul xn2).mul xd).mul yd2)).add
        (((a₄.mul xn).mul xd2).mul yd2)).add ((a₆.mul xd3).mul yd2))

/-- The same identity on the kernel functions `Z.mul` and `Z.add`. -/
noncomputable def checkPointZ (a₂ a₄ a₆ : Int) (x y : Rat) : Bool :=
  let xn := x.num; let xd := Int.ofNat x.den
  let yn := y.num; let yd := Int.ofNat y.den
  let xd2 := Z.mul xd xd; let xd3 := Z.mul xd2 xd
  let yd2 := Z.mul yd yd
  let xn2 := Z.mul xn xn; let xn3 := Z.mul xn2 xn
  let yn2 := Z.mul yn yn
  Int.beq' (Z.mul yn2 xd3)
    (Z.add (Z.add (Z.add (Z.mul xn3 yd2) (Z.mul (Z.mul (Z.mul a₂ xn2) xd) yd2))
        (Z.mul (Z.mul (Z.mul a₄ xn) xd2) yd2)) (Z.mul (Z.mul a₆ xd3) yd2))

/-- A rational with a given numerator and denominator, for points with coprime coordinates. -/
def ratOf (num : Int) (den : Nat) : Rat := mkRat num den

