/-- Guards on both rows, one product of their integers, and the `ℓ¹` norm of the product row:
the packed check, with core's `Int.mul`. -/
noncomputable def packedProductNorm (w g n : Nat) (u v : Nat) : Nat :=
  Bool.rec (motive := fun _ => Nat) 0
    (Packed.absSum w (2 * n - 1) (Int.mul (Packed.toInt w n u) (Packed.toInt w n v)))
    (Bool.and (Packed.guard w g n u) (Packed.guard w g n v))

/-- The same norm entry by entry: the Cauchy product of the two entry lists. -/
noncomputable def listProductNorm (w n : Nat) (u v : Nat) : Nat :=
  Packed.l1 (Packed.conv (Packed.entries w n u) (Packed.entries w n v))

