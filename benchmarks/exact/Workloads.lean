/-! ## HighlyAbundant: the divisor sum of a prime power and its comparison with the goal -/

/-- `ceilDivK` of HighlyAbundant. -/
def ceilDivK (a b : Nat) : Nat := ((a.add b).sub (nat_lit 1)).div b

/-- One step of `expChildrenK` (HighlyAbundant, `IsHA/SageKernel.lean`): the divisor sum
`σ(p ^ k) = (p ^ (k + 1) - 1) / (p - 1)`, the next goal, and the test `goal ≤ σ(p ^ k)`. -/
noncomputable def expChildStep (goal cand p pk : Nat) : Nat :=
  let spk := ((pk.mul p).sub (nat_lit 1)).div (p.sub (nat_lit 1))
  (goal.ble spk).rec (Nat.add (ceilDivK goal spk) (cand.mul pk)) 0
#kernel_op "ha/expChildren step" (sizes := [64, 128, 256]) (count := 32) fun goal cand p pk : Nat =>
  expChildStep (Nat.mul goal pk) cand p pk

