(FPCore (y)
  :name "sqroot"
  :description "Generated by FPTaylor"
  :precision real
  :round nearestEven
  :pre (and (<= 0 y 1))
  (! :precision binary64 (- (+ (- (+ 1 (* 1/2 (cast y)))
                                  (* (* 1/8 (cast y)) (cast y)))
                               (* (* (* 1/16 (cast y)) (cast y)) (cast y)))
                            (* (* (* (* 5/128 (cast y)) (cast y)) (cast y))
                               (cast y)))))

