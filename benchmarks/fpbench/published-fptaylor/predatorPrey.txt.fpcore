(FPCore (x)
  :name "predatorPrey"
  :description "Generated by FPTaylor"
  :precision real
  :round nearestEven
  :pre (and (<= 1/10 x 3/10))
  (! :precision binary64 (/ (* (* 4 (cast x)) (cast x))
                            (+ 1
                               (* (/ (cast x) 111/100) (/ (cast x) 111/100))))))

