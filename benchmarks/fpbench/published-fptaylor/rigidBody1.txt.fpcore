(FPCore (x3 x1 x2)
  :name "rigidBody1"
  :description "Generated by FPTaylor"
  :precision real
  :round nearestEven
  :pre (and (<= -15 x3 15) (<= -15 x1 15) (<= -15 x2 15))
  (! :precision binary64 (- (- (- (* (- (cast x1)) (cast x2))
                                  (* (* 2 (cast x2)) (cast x3)))
                               (cast x1))
                            (cast x3))))

