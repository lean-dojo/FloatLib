"function fn1(x) {\n\tvar tmp;\n\tif (x < 0) {\n\t\ttmp = x + 1;\n\t} else {\n\t\ttmp = x - 1;\n\t}\n\treturn tmp;\n}\n"
"function fn2(x) {\n\tvar x_1 = 1;\n\tvar y = x;\n\treturn x_1 + y;\n}\n"
"function fn3(x) {\n\tvar x_1 = 1;\n\tvar y = x_1;\n\treturn x_1 + y;\n}\n"
"function fn4(x) {\n\tvar x_1 = 0.0;\n\tvar tmp = x_1 < 4;\n\twhile (tmp) {\n\t\tvar x_2 = x_1 + 1.0;\n\t\tx_1 = x_2;\n\t\ttmp = x_1 < 4;\n\t}\n\treturn x_1;\n}\n"
"function fn5(x) {\n\tvar x_1 = 0.0;\n\tvar tmp = x_1 < 4;\n\twhile (tmp) {\n\t\tx_1 = x_1 + 1.0;\n\t\ttmp = x_1 < 4;\n\t}\n\treturn x_1;\n}\n"
"function fn6(x) {\n\treturn foo(x) + 1;\n}\n"
"function fn7(x) {\n\treturn sqrt((x + 1)) - sqrt(x);\n}\n"
"function fn8(a, b) {\n\treturn (a * b) + (a - b);\n}\n"
