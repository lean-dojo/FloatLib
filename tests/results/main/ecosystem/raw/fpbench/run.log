"fun fn1 x = if (x < 0) then\n    (x + 1)\n  else\n    (x - 1)\n"
"fun fn2 x = let\n    val x_1 = 1\n    val y = x\n  in\n    x_1 + y\n  end\n"
"fun fn3 x = let\n    val x_1 = 1\n    val y = x_1\n  in\n    x_1 + y\n  end\n"
"fun fn4 x = let\n    val x_1 = 0.0\n    fun loop x_1 =\n      if (x_1 < 4) then\n        let\n          val x_2 =  x_1 + 1.0\n        in\n          loop x_2\n        end\n      else\n        x_1\n  in\n    loop x_1\n  end\n"
"fun fn5 x = let\n    val x_1 = 0.0\n    fun loop x_1 =\n      if (x_1 < 4) then\n        let\n          val x_2 =  x_1 + 1.0\n        in\n          loop x_2\n        end\n      else\n        x_1\n  in\n    loop x_1\n  end\n"
"fun fn6 x = foo x + 1\n"
"fun fn7 x = sqrt (x + 1) - sqrt x\n"
"fun fn8 a b = (a * b) + (a - b)\n"
