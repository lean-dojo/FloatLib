module

public import FloatLib.Floats.Formats.IEEE754.Native.AddSub
public import FloatLib.Floats.Formats.IEEE754.Native.Integer
public import FloatLib.Floats.Formats.IEEE754.Native.MulDiv
public import FloatLib.Floats.Formats.IEEE754.Native.Sqrt
public import FloatLib.Tactic.NativeRule

/-!
# `roundoff` rules for Lean's native floats

`roundoff` reads a computation in Lean's `Float32` or `Float` through its import into binary32 or
binary64: the observation is `ExecFloat.Binary.toReal (ExecFloat.Binary.ofFloat32 value)`, with
`ofFloat` for `Float`. This module supplies the rules that move the imports through native
operations.
`FloatLib.Tactic.Roundoff.Native` registers the two imports (`Extension.imports`).
`FloatLib.Tactic.Roundoff` imports both, so these rules come with the tactic and stay
outside `import FloatLib`.

* An input of a native type is a stored value: its import is exact data, and its finiteness is a
  condition on the input (`isFinite_ofFloat32`: the native finiteness test).
* The import of a native sum, difference, product or quotient of values with finite imports is
  the configured operation on the imports (`toReal_ofFloat32_add` and its siblings, generated by
  `native_rule` from the agreement theorems of `Native.AddSub` and `Native.MulDiv`). The
  configured operation then gets its usual rounding rule, so a native operation has the bound of
  the binary32 or binary64 operation.
* The import of a native square root has the real value and the finiteness of the configured
  square root of the import, for every input (`toReal_ofFloat32_sqrt`).
* The import of a native negation is the negation of the import (`toReal_ofFloat32_neg`), and a
  native numeral is the conversion of its natural number (`ofFloat32_ofNat`), which `roundoff`
  reads as C's `(float) n`. A scientific literal such as `0.5` has no proved law and is refused.
* A binary32 value exported with `toFloat32` and imported again keeps its real value and its
  finiteness (`toReal_ofFloat32_toFloat32`), and likewise binary64 through `Float`.

What these rules rest on, as `TRUST.md` states it: the theorems equate Lean definitions, namely
Lean's logical model of `Float32` and `Float` and FloatLib's arithmetic. That the compiled code
and the host follow that model is trusted, not proved. The elementary functions of the native
types are host library calls with no rounding guarantee, so they have no rule here and `roundoff`
refuses them.
-/

@[expose] public section

namespace FloatLib.Floats.Formats.BinaryInterchange.Model

/-- For an IEEE descriptor, canonicalizing the NaN of a word keeps its finiteness. -/
theorem isFinite_canonicalizeModel {fmt : FloatFormat} (hfmt : fmt.isIEEE = true)
    (x : Model fmt) : isFinite (canonicalizeModel x) = isFinite x := by
  rw [← isFinite_toModel hfmt, ← isFinite_toModel hfmt, toModel_canonicalizeModel]

/-- For an IEEE descriptor, canonicalizing the NaN of a word keeps its real value. -/
theorem toReal_canonicalizeModel {fmt : FloatFormat} (hfmt : fmt.isIEEE = true)
    (x : Model fmt) : toReal (canonicalizeModel x) = toReal x := by
  rw [toReal_eq, toReal_eq, toDyadic?_ieee_eq_model fmt hfmt, toDyadic?_ieee_eq_model fmt hfmt,
    toModel_canonicalizeModel]

end FloatLib.Floats.Formats.BinaryInterchange.Model

namespace FloatLib.Floats.ExecFloat.Binary

open Formats.BinaryInterchange

/-- The import of a native binary32 value is finite exactly when Lean's test says the value is. -/
theorem isFinite_ofFloat32 (x : Float32) : isFinite (ofFloat32 x : Binary32) = x.isFinite :=
  (Model.isFinite_toModel (fmt := FloatFormat.binary32) (by decide)
    (Model.ofFloat32Model x.toModel)).symm

/-- The import of a native binary64 value is finite exactly when Lean's test says the value is. -/
theorem isFinite_ofFloat (x : Float) : isFinite (ofFloat x : Binary64) = x.isFinite :=
  (Model.isFinite_toModel (fmt := FloatFormat.binary64) (by decide)
    (Model.ofFloatModel x.toModel)).symm

native_rule ofFloat32_add : ofFloat32 Float32 into Binary32, HAdd.hAdd :=
  ofFloat32_add_of_isFinite by isFinite_ofFloat32
native_rule ofFloat32_sub : ofFloat32 Float32 into Binary32, HSub.hSub :=
  ofFloat32_sub_of_isFinite by isFinite_ofFloat32
native_rule ofFloat32_mul : ofFloat32 Float32 into Binary32, HMul.hMul :=
  ofFloat32_mul_of_isFinite by isFinite_ofFloat32
native_rule ofFloat32_div : ofFloat32 Float32 into Binary32, HDiv.hDiv :=
  ofFloat32_div_of_isFinite by isFinite_ofFloat32
native_rule ofFloat_add : ofFloat Float into Binary64, HAdd.hAdd :=
  ofFloat_add_of_isFinite by isFinite_ofFloat
native_rule ofFloat_sub : ofFloat Float into Binary64, HSub.hSub :=
  ofFloat_sub_of_isFinite by isFinite_ofFloat
native_rule ofFloat_mul : ofFloat Float into Binary64, HMul.hMul :=
  ofFloat_mul_of_isFinite by isFinite_ofFloat
native_rule ofFloat_div : ofFloat Float into Binary64, HDiv.hDiv :=
  ofFloat_div_of_isFinite by isFinite_ofFloat

/-- The import of a native binary32 square root has the real value of the configured square root
of the import, for every input. -/
@[roundoff_rule] theorem toReal_ofFloat32_sqrt (x : Float32) :
    toReal (ofFloat32 x.sqrt : Binary32) = toReal (ExecFloat.sqrt (ofFloat32 x : Binary32)) := by
  unfold toReal
  rw [toModel_ofFloat32_sqrt, toModel_execFloat_sqrt,
    Model.toReal_canonicalizeModel (by decide)]

/-- The import of a native binary32 square root is finite when the configured square root of the
import is. -/
@[roundoff_rule] theorem isFinite_ofFloat32_sqrt {x : Float32}
    (hresult : isFinite (ExecFloat.sqrt (ofFloat32 x : Binary32)) = true) :
    isFinite (ofFloat32 x.sqrt : Binary32) = true := by
  unfold isFinite at hresult ⊢
  rwa [toModel_ofFloat32_sqrt, Model.isFinite_canonicalizeModel (by decide),
    ← toModel_execFloat_sqrt]

/-- The import of a native binary64 square root has the real value of the configured square root
of the import, for every input. -/
@[roundoff_rule] theorem toReal_ofFloat_sqrt (x : Float) :
    toReal (ofFloat x.sqrt : Binary64) = toReal (ExecFloat.sqrt (ofFloat x : Binary64)) := by
  unfold toReal
  rw [toModel_ofFloat_sqrt, toModel_execFloat_sqrt, Model.toReal_canonicalizeModel (by decide)]

/-- The import of a native binary64 square root is finite when the configured square root of the
import is. -/
@[roundoff_rule] theorem isFinite_ofFloat_sqrt {x : Float}
    (hresult : isFinite (ExecFloat.sqrt (ofFloat x : Binary64)) = true) :
    isFinite (ofFloat x.sqrt : Binary64) = true := by
  unfold isFinite at hresult ⊢
  rwa [toModel_ofFloat_sqrt, Model.isFinite_canonicalizeModel (by decide),
    ← toModel_execFloat_sqrt]

/-- Native binary32 negation agrees with FloatLib's negation through the import adapter, for
every input. Canonicalization discards only NaN signs and payloads. -/
theorem toModel_ofFloat32_neg (x : Float32) :
    toModel (ofFloat32 (-x) : Binary32) =
      Model.canonicalizeModel (Model.neg (toModel (ofFloat32 x : Binary32))) := by
  rw [toModel_ofFloat32, toModel_ofFloat32]
  change Model.ofFloat32Model (Float32.Model.neg x.toModel) = _
  rw [Float32.Model.neg, Model.ofFloat32Model_pack]
  have h := congrArg (Model.ofModel FloatFormat.binary32) (Model.toModel_neg
    (fmt := FloatFormat.binary32) (by decide) (Model.ofFloat32Model x.toModel))
  rw [Model.toModel_ofFloat32Model] at h
  exact h.symm

/-- Native binary64 negation agrees with FloatLib's negation through the import adapter, for
every input. -/
theorem toModel_ofFloat_neg (x : Float) :
    toModel (ofFloat (-x) : Binary64) =
      Model.canonicalizeModel (Model.neg (toModel (ofFloat x : Binary64))) := by
  rw [toModel_ofFloat, toModel_ofFloat]
  change Model.ofFloatModel (Float.Model.neg x.toModel) = _
  rw [Float.Model.neg, Model.ofFloatModel_pack]
  have h := congrArg (Model.ofModel FloatFormat.binary64) (Model.toModel_neg
    (fmt := FloatFormat.binary64) (by decide) (Model.ofFloatModel x.toModel))
  rw [Model.toModel_ofFloatModel] at h
  exact h.symm

/-- The import of a native binary32 negation has the real value of the negated import. -/
@[roundoff_rule] theorem toReal_ofFloat32_neg (x : Float32) :
    toReal (ofFloat32 (-x) : Binary32) = toReal (-(ofFloat32 x : Binary32)) := by
  unfold toReal
  rw [toModel_ofFloat32_neg, toModel_neg, Model.toReal_canonicalizeModel (by decide)]

/-- The import of a native binary32 negation is finite when the import is. -/
@[roundoff_rule] theorem isFinite_ofFloat32_neg {x : Float32}
    (hx : isFinite (ofFloat32 x : Binary32) = true) :
    isFinite (ofFloat32 (-x) : Binary32) = true := by
  rw [← isFinite_neg] at hx
  unfold isFinite at hx ⊢
  rwa [toModel_ofFloat32_neg, Model.isFinite_canonicalizeModel (by decide), ← toModel_neg]

/-- The import of a native binary64 negation has the real value of the negated import. -/
@[roundoff_rule] theorem toReal_ofFloat_neg (x : Float) :
    toReal (ofFloat (-x) : Binary64) = toReal (-(ofFloat x : Binary64)) := by
  unfold toReal
  rw [toModel_ofFloat_neg, toModel_neg, Model.toReal_canonicalizeModel (by decide)]

/-- The import of a native binary64 negation is finite when the import is. -/
@[roundoff_rule] theorem isFinite_ofFloat_neg {x : Float}
    (hx : isFinite (ofFloat x : Binary64) = true) :
    isFinite (ofFloat (-x) : Binary64) = true := by
  rw [← isFinite_neg] at hx
  unfold isFinite at hx ⊢
  rwa [toModel_ofFloat_neg, Model.isFinite_canonicalizeModel (by decide), ← toModel_neg]

/-- A native binary32 numeral is the conversion of the natural number: C's `(float) n`. -/
theorem ofFloat32_ofNat (n : Nat) :
    (ofFloat32 (Float32.ofNat n) : Binary32) = ofRat (n : ℚ) := by
  apply Configured.Family.toModel_injective
  change toModel (ofFloat32 (Float32.ofNat n) : Binary32) = toModel (ofRat (n : ℚ) : Binary32)
  rw [toModel_ofFloat32_ofNat, toModel_ofRat]
  change _ = Model.roundRat FloatFormat.binary32 (decide ((n : ℚ).num < 0)) (n : ℚ).num.natAbs
    (n : ℚ).den
  simp [show ¬((n : ℤ) < 0) from not_lt.mpr (Int.natCast_nonneg n)]

/-- A native binary64 numeral is the conversion of the natural number: C's `(double) n`. -/
theorem ofFloat_ofNat (n : Nat) : (ofFloat (Float.ofNat n) : Binary64) = ofRat (n : ℚ) := by
  apply Configured.Family.toModel_injective
  change toModel (ofFloat (Float.ofNat n) : Binary64) = toModel (ofRat (n : ℚ) : Binary64)
  rw [toModel_ofFloat_ofNat, toModel_ofRat]
  change _ = Model.roundRat FloatFormat.binary64 (decide ((n : ℚ).num < 0)) (n : ℚ).num.natAbs
    (n : ℚ).den
  simp [show ¬((n : ℤ) < 0) from not_lt.mpr (Int.natCast_nonneg n)]

/-- The import of a native binary32 numeral has the real value of the converted natural number. -/
@[roundoff_rule] theorem toReal_ofFloat32_ofNat (n : Nat) :
    toReal (ofFloat32 (Float32.ofNat n) : Binary32) = toReal (ofRat (n : ℚ) : Binary32) :=
  congrArg toReal (ofFloat32_ofNat n)

/-- The import of a native binary32 numeral is finite when the converted natural number is. -/
@[roundoff_rule] theorem isFinite_ofFloat32_ofNat {n : Nat}
    (hresult : isFinite (ofRat (n : ℚ) : Binary32) = true) :
    isFinite (ofFloat32 (Float32.ofNat n) : Binary32) = true :=
  (congrArg isFinite (ofFloat32_ofNat n)).trans hresult

/-- The import of a native binary64 numeral has the real value of the converted natural number. -/
@[roundoff_rule] theorem toReal_ofFloat_ofNat (n : Nat) :
    toReal (ofFloat (Float.ofNat n) : Binary64) = toReal (ofRat (n : ℚ) : Binary64) :=
  congrArg toReal (ofFloat_ofNat n)

/-- The import of a native binary64 numeral is finite when the converted natural number is. -/
@[roundoff_rule] theorem isFinite_ofFloat_ofNat {n : Nat}
    (hresult : isFinite (ofRat (n : ℚ) : Binary64) = true) :
    isFinite (ofFloat (Float.ofNat n) : Binary64) = true :=
  (congrArg isFinite (ofFloat_ofNat n)).trans hresult

/-- A round trip of binary32 through `Float32` canonicalizes its NaN and nothing else. -/
theorem toModel_ofFloat32_toFloat32 (value : Binary32) :
    toModel (ofFloat32 (toFloat32 value) : Binary32) = Model.canonicalizeModel (toModel value) := by
  rw [toModel_ofFloat32, toModel_toFloat32_eq, Model.ofFloat32Model_toFloat32Model]
  rfl

/-- A round trip of binary64 through `Float` canonicalizes its NaN and nothing else. -/
theorem toModel_ofFloat_toFloat (value : Binary64) :
    toModel (ofFloat (toFloat value) : Binary64) = Model.canonicalizeModel (toModel value) := by
  rw [toModel_ofFloat, toModel_toFloat_eq, Model.ofFloatModel_toFloatModel]
  rfl

/-- A binary32 value exported to `Float32` and imported again keeps its real value. -/
@[roundoff_rule] theorem toReal_ofFloat32_toFloat32 (value : Binary32) :
    toReal (ofFloat32 (toFloat32 value) : Binary32) = toReal value := by
  unfold toReal
  rw [toModel_ofFloat32_toFloat32, Model.toReal_canonicalizeModel (by decide)]

/-- A finite binary32 value exported to `Float32` and imported again is finite. -/
@[roundoff_rule] theorem isFinite_ofFloat32_toFloat32 {value : Binary32}
    (hvalue : isFinite value = true) :
    isFinite (ofFloat32 (toFloat32 value) : Binary32) = true := by
  unfold isFinite at hvalue ⊢
  rwa [toModel_ofFloat32_toFloat32, Model.isFinite_canonicalizeModel (by decide)]

/-- A binary64 value exported to `Float` and imported again keeps its real value. -/
@[roundoff_rule] theorem toReal_ofFloat_toFloat (value : Binary64) :
    toReal (ofFloat (toFloat value) : Binary64) = toReal value := by
  unfold toReal
  rw [toModel_ofFloat_toFloat, Model.toReal_canonicalizeModel (by decide)]

/-- A finite binary64 value exported to `Float` and imported again is finite. -/
@[roundoff_rule] theorem isFinite_ofFloat_toFloat {value : Binary64}
    (hvalue : isFinite value = true) : isFinite (ofFloat (toFloat value) : Binary64) = true := by
  unfold isFinite at hvalue ⊢
  rwa [toModel_ofFloat_toFloat, Model.isFinite_canonicalizeModel (by decide)]

end FloatLib.Floats.ExecFloat.Binary

end
