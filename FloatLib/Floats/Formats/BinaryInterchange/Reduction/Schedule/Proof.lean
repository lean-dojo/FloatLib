/-!
# Error bounds for the reductions of §9.4 in a chosen order and accumulator format

`Reduction.Schedule.Runtime` defines the reductions `sum`, `sumAbs`, `sumSquare` and `dot` of
IEEE 754-2019 §9.4 over the freedom that the standard leaves: the association order and the
format of the intermediate results. This module bounds their error against the exact real
reduction.

* **Any order.** `abs_toReal_reduceAlong_sub_le`: for every association order (every
  `ReductionTree`), every term function, an IEEE accumulator format and an IEEE destination
  format, a finite evaluation is within `((1 + u) ^ n - 1) * Σ |tᵢ|` of the exact sum of its
  terms `tᵢ`, plus half a unit in the last place of the destination for the final conversion,
  where `u` is the unit roundoff of the accumulator and `n` the number of additions.
  `abs_toReal_reduceAlong_sub_le_depth` is the same bound with the depth of the order in place
  of `n`, which is about `log₂` of the number of terms for an order that pairs them.
* **Left to right, any length.** `reduceInOrder_eq_reduceAlong`: the loop is the member of the
  family along the left-leaning schedule that starts at `+0`. `sumInOrder_mixedError`,
  `sumAbsInOrder_mixedError`, `sumSquareInOrder_mixedError` and `dotInOrder_mixedError` are
  generated by `roundoff` from the definitions: a mixed relative and absolute error bound
  against the exact real sum, sum of absolute values, sum of squares and dot product of the
  inputs, for a list of any length and all source, accumulator and destination descriptors
  such that the grid of the accumulator contains the grid of the source (the standard's "wider
  format"), which makes the conversion of every input exact. The premises are the ones
  `roundoff` states: IEEE accumulator and destination, finite inputs, and no overflow at the
  states that the loop visits.
-/

@[expose] public section

namespace FloatLib.Numerics.ReductionTree

/--
Evaluating the schedule that extends `start` by a list is a left fold over the list from the
value of `start`.
-/
theorem eval_extend {α β : Type*} (combine : β → β → β) (value : α → β)
    (start : ReductionTree α) (values : List α) :
    (start.extend values).eval combine value =
      values.foldl (fun state v => combine state (value v)) (start.eval combine value) := by
  induction values generalizing start with
  | nil => rfl
  | cons v rest ih =>
      rw [extend, ih]
      rfl

end FloatLib.Numerics.ReductionTree

namespace FloatLib.Floats.Formats.BinaryInterchange.Model

open FloatLib.Numerics

variable {α : Type} {src acc out : FloatFormat}

/--
The reduction from left to right is the reduction along the left-leaning schedule that starts
at `+0`: `((+0 + t₁) + t₂) + …`.
-/
theorem reduceInOrder_eq_reduceAlong (term : α → Model acc) (values : List α) :
    reduceInOrder acc out term values =
      reduceAlong acc out (fun v : Option α => v.elim (zero acc false) term)
        ((Numerics.ReductionTree.leaf none).extend (values.map some)) := by
  unfold reduceInOrder reduceAlong
  rw [Numerics.ReductionTree.eval_extend, List.foldl_map]
  rfl

/--
The final conversion of a reduction: a bound on the error of the accumulated tree gives the same
bound on the delivered result, plus half a unit in the last place of the destination at the
accumulated value.
-/
theorem abs_toReal_reduceAlong_sub_le_of_tree (term : α → Model acc)
    (schedule : Numerics.ReductionTree α) (hout : out.isIEEE = true)
    (hresult : isFinite (reduceAlong acc out term schedule) = true) {bound : ℝ}
    (htree : |toReal ((schedule.map term).eval (fun x y => add x y) id) -
        ((schedule.map term).leaves.map toReal).sum| ≤ bound) :
    |toReal (reduceAlong acc out term schedule) -
        ((schedule.map term).leaves.map toReal).sum| ≤
      bound + halfUlpAt out (toReal ((schedule.map term).eval (fun x y => add x y) id)) := by
  have heval : schedule.eval (fun x y => add x y) term =
      (schedule.map term).eval (fun x y => add x y) id :=
    (Numerics.ReductionTree.eval_map schedule term _ id).symm
  unfold reduceAlong at hresult ⊢
  rw [heval] at hresult ⊢
  have hcast := abs_toReal_cast_sub_le _ hout hresult
  exact (abs_sub_le _ _ _).trans (by linarith)

/--
A reduction in any association order, with an IEEE accumulator format and an IEEE destination
format, whose intermediate results and result are finite: its distance from the exact sum of
its terms is at most `((1 + u) ^ n - 1) * Σ |tᵢ|` for the `n` additions in the accumulator,
whose unit roundoff is `u`, plus half a unit in the last place of the destination at the
accumulated value for the final conversion. No hypothesis on the normal range is needed.
-/
theorem abs_toReal_reduceAlong_sub_le (term : α → Model acc)
    (schedule : Numerics.ReductionTree α) (hacc : acc.isIEEE = true) (hout : out.isIEEE = true)
    (hfinite : ReductionTree.FiniteEval (schedule.map term))
    (hresult : isFinite (reduceAlong acc out term schedule) = true) :
    |toReal (reduceAlong acc out term schedule) -
        ((schedule.map term).leaves.map toReal).sum| ≤
      ((1 + unitRoundoffAt acc) ^ (schedule.map term).nodeCount - 1) *
          (schedule.map term).sumAbs toReal +
        halfUlpAt out (toReal ((schedule.map term).eval (fun x y => add x y) id)) :=
  abs_toReal_reduceAlong_sub_le_of_tree term schedule hout hresult
    (ReductionTree.abs_toReal_eval_sub_sum_le_geometric (schedule.map term) hacc hfinite)

/--
The same reduction, bounded in the depth `d` of its association order instead of its number of
additions: at most `((1 + u) ^ d - 1) * Σ |tᵢ|`, plus the half unit of the final conversion. An
order that pairs its `n` terms has depth about `log₂ n`.
-/
theorem abs_toReal_reduceAlong_sub_le_depth (term : α → Model acc)
    (schedule : Numerics.ReductionTree α) (hacc : acc.isIEEE = true) (hout : out.isIEEE = true)
    (hfinite : ReductionTree.FiniteEval (schedule.map term))
    (hresult : isFinite (reduceAlong acc out term schedule) = true) :
    |toReal (reduceAlong acc out term schedule) -
        ((schedule.map term).leaves.map toReal).sum| ≤
      ((1 + unitRoundoffAt acc) ^ schedule.depth - 1) *
          (schedule.map term).sumAbs toReal +
        halfUlpAt out (toReal ((schedule.map term).eval (fun x y => add x y) id)) := by
  have htree := ReductionTree.abs_toReal_eval_sub_sum_le_depth (schedule.map term) hacc hfinite
  rw [Numerics.ReductionTree.depth_map] at htree
  exact abs_toReal_reduceAlong_sub_le_of_tree term schedule hout hresult htree

/--
The value of a reduction from left to right is the value of its loop. Registered with
`roundoff`, which analyzes the loop: the step adds one term to the accumulator.
-/
@[roundoff_rule] theorem toReal_reduceInOrder (term : α → Model acc) (values : List α) :
    toReal (reduceInOrder acc out term values) =
      toReal (cast acc out (values.foldl (fun s v => add s (term v)) (zero acc false))) :=
  rfl

in_order_rule sum (Model src)

in_order_rule sumAbs (Model src)

in_order_rule sumSquare (Model src)

in_order_rule dot (Model src × Model src)

/--
IEEE 754-2019 §9.4 `sum` from left to right in an accumulator whose grid contains the source
grid: the mixed error bound that `roundoff` derives from `sumInOrder`, against the exact sum of
the inputs, for a list of any length.
-/
roundoff mixed theorem sumInOrder_mixedError :=
  fun (src acc out : FloatFormat) (hfrac : src.fracWidth ≤ acc.fracWidth)
    (hmin : acc.minSubnormalExponent ≤ src.minSubnormalExponent) (values : List (Model src)) =>
    Model.toReal (sumInOrder acc out values)

/--
IEEE 754-2019 §9.4 `sumAbs` from left to right in an accumulator whose grid contains the
source grid: the mixed error bound that `roundoff` derives from `sumAbsInOrder`, against the
exact sum of the absolute values of the inputs, for a list of any length.
-/
roundoff mixed theorem sumAbsInOrder_mixedError :=
  fun (src acc out : FloatFormat) (hfrac : src.fracWidth ≤ acc.fracWidth)
    (hmin : acc.minSubnormalExponent ≤ src.minSubnormalExponent) (values : List (Model src)) =>
    Model.toReal (sumAbsInOrder acc out values)

/--
IEEE 754-2019 §9.4 `sumSquare` from left to right in an accumulator whose grid contains the
source grid: the mixed error bound that `roundoff` derives from `sumSquareInOrder`, against the
exact sum of the squares of the inputs, for a list of any length.
-/
roundoff mixed theorem sumSquareInOrder_mixedError :=
  fun (src acc out : FloatFormat) (hfrac : src.fracWidth ≤ acc.fracWidth)
    (hmin : acc.minSubnormalExponent ≤ src.minSubnormalExponent) (values : List (Model src)) =>
    Model.toReal (sumSquareInOrder acc out values)

/--
IEEE 754-2019 §9.4 `dot` from left to right in an accumulator whose grid contains the source
grid: the mixed error bound that `roundoff` derives from `dotInOrder`, against the exact dot
product of the pairs, for a list of any length.
-/
roundoff mixed theorem dotInOrder_mixedError :=
  fun (src acc out : FloatFormat) (hfrac : src.fracWidth ≤ acc.fracWidth)
    (hmin : acc.minSubnormalExponent ≤ src.minSubnormalExponent)
    (values : List (Model src × Model src)) =>
    Model.toReal (dotInOrder acc out values)

end FloatLib.Floats.Formats.BinaryInterchange.Model
