# Lean and native build output
.lake
build/
lake-packages/
_out/
*.olean
*.ilean
*.o
*.a
*.so
*.dylib

# Website and Python output
/site/data/
node_modules/
dist/
.venv/
__pycache__/
*.py[cod]
.cache/
.pytest_cache/
.ruff_cache/

# Local settings and manuscripts
.DS_Store
.claude/
.vscode/
.env
.env.*
!.env.example
/paper/
/papers/

# Reference checkouts downloaded by the benchmark suites
/benchmarks/correct-rounding/**/upstream/
/benchmarks/fpbench/**/upstream/
/benchmarks/inequalities/**/upstream/
/benchmarks/testfloat/**/upstream/

# Keep complete published evidence, including the recorded comparison providers.
/benchmarks/results/*
!/benchmarks/results/flocq-matched/
/benchmarks/results/flocq-matched/*
!/benchmarks/results/flocq-matched/README.md
!/benchmarks/results/flocq-matched/publication-redactions.json
!/benchmarks/results/flocq-matched/matched-benchmark-summary.csv
!/benchmarks/results/flocq-matched/matched-comparison-evidence.zip
!/benchmarks/results/kernel/
/benchmarks/results/kernel/*
!/benchmarks/results/kernel/README.md
!/benchmarks/results/backends/
/benchmarks/results/backends/*
!/benchmarks/results/backends/README.md
!/benchmarks/results/backends/*.csv
!/benchmarks/results/backends/*.png
!/benchmarks/results/p3109-flops/
/benchmarks/results/p3109-flops/*
!/benchmarks/results/p3109-flops/results.json
!/benchmarks/results/tensorlib/
/benchmarks/results/tensorlib/*
!/benchmarks/results/tensorlib/results.json
!/benchmarks/results/roundoff/
/benchmarks/results/roundoff/*
!/benchmarks/results/roundoff/README.md
!/benchmarks/results/roundoff/bounds.json
!/benchmarks/results/public-binary/
/benchmarks/results/public-binary/*
!/benchmarks/results/public-binary/measurements.csv
!/benchmarks/results/public-binary/metadata.json
!/benchmarks/results/ieee2019/
/benchmarks/results/ieee2019/*
!/benchmarks/results/ieee2019/README.md
!/benchmarks/results/ieee2019/*.csv
!/benchmarks/results/exact/
/benchmarks/results/exact/*
!/benchmarks/results/exact/README.md
!/benchmarks/results/exact/*.md
!/benchmarks/results/exact/*.log
/tests/results/*
!/tests/results/differential/
!/tests/results/differential/**

# Repository-history backups can contain unpublished manuscripts.
*.bundle
