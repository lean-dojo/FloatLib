# Keep complete published evidence, including the recorded comparison providers.
/benchmarks/results/*
!/benchmarks/results/main/
!/benchmarks/results/main/**
!/benchmarks/results/flocq-matched/
/benchmarks/results/flocq-matched/*
!/benchmarks/results/flocq-matched/README.md
!/benchmarks/results/flocq-matched/matched-benchmark-summary.csv
!/benchmarks/results/flocq-matched/matched-comparison-evidence.zip
!/benchmarks/results/p3109-flops/
/benchmarks/results/p3109-flops/*
!/benchmarks/results/p3109-flops/results.json
!/benchmarks/results/tensorlib/
/benchmarks/results/tensorlib/*
!/benchmarks/results/tensorlib/results.json
!/benchmarks/results/public-binary/
/benchmarks/results/public-binary/*
!/benchmarks/results/public-binary/measurements.csv
!/benchmarks/results/public-binary/metadata.json
/tests/results/*
!/tests/results/main/
!/tests/results/main/**

# Repository-history backups can contain unpublished manuscripts.
*.bundle
# The original benchmark source archive also embeds a history bundle.
/benchmarks/results/main/provenance/FloatLib-source.tar.gz
